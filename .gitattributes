# Normalize line endings to LF for text files so committed diffs never carry
# CRLF trailing-whitespace noise, regardless of contributor OS.
* text=auto eol=lf

*.go    text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.tf    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
Makefile text eol=lf

# Binary artifacts.
*.zip   binary
*.exe   binary
